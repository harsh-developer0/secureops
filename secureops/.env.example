# Copy this file to .env (see README). Never commit .env.
BACKEND_PORT=3001
TARGET_URL=http://localhost:4000
CHECK_INTERVAL_SECONDS=10
DB_PATH=../data/secureops.db
# Shared secret that lets CI/helper scripts post results to the backend.
# Change this to any long random string.
INGEST_TOKEN=change-me-to-a-long-random-string
